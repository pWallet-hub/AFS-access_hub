# Copy to .env and replace every change-me value before starting the stack.
# Production: set ENVIRONMENT=production, use https:// addresses below, and start with docker-compose.prod.yml.
ENVIRONMENT=development
# .env is git-ignored; never commit real secrets.

# PostgreSQL (also owns the Keycloak database)
POSTGRES_USER=afs
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=afs_command_center

# Keycloak administrator (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# AFS realm and the Command Center OIDC client
KEYCLOAK_REALM=afs
OIDC_CLIENT_ID=afs-command-center
OIDC_CLIENT_SECRET=change-me-oidc-client-secret

# Signs the backend session cookie. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-session-secret

# URLs as seen from the browser
PUBLIC_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Integrated applications, one per product (frontend and backend together). The client belongs to the
# product's backend, which runs the sign-in. *_REDIRECT_URI is that backend's callback; *_ORIGIN is the
# frontend's web address. Each product's service token is shared only with its backend.
# ImageUnit (its web app and API are one application)
IMAGEUNIT_OIDC_CLIENT_ID=imageunit
IMAGEUNIT_OIDC_CLIENT_SECRET=change-me-imageunit-client-secret
IMAGEUNIT_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback
IMAGEUNIT_ORIGIN=http://localhost:4001
AFS_SERVICE_TOKEN_IMAGEUNIT=change-me-imageunit-service-token

# Biocap (Biocap Rwanda frontend, Biocap Dashboard backend)
BIOCAP_OIDC_CLIENT_ID=biocap
BIOCAP_OIDC_CLIENT_SECRET=change-me-biocap-client-secret
BIOCAP_REDIRECT_URI=http://localhost:5000/api/auth/sso/callback
BIOCAP_ORIGIN=http://localhost:3000
AFS_SERVICE_TOKEN_BIOCAP=change-me-biocap-service-token

# Procurement (Procurement FN portal, Procurement BN backend)
PROCUREMENT_OIDC_CLIENT_ID=procurement
PROCUREMENT_OIDC_CLIENT_SECRET=change-me-procurement-client-secret
PROCUREMENT_REDIRECT_URI=http://localhost:3100/api/v1/auth/sso/callback
PROCUREMENT_ORIGIN=http://localhost:5173
AFS_SERVICE_TOKEN_PROCUREMENT=change-me-procurement-service-token

# Email through Resend (https://resend.com). Keycloak sends verification and password-reset mail through its SMTP
# service; Command Center sends notices (account, access changes) through the HTTP API. Leave RESEND_API_KEY empty to
# turn mail off. RESEND_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME=AFS Command Center

# Test account created in the AFS realm on first start
BOOTSTRAP_ADMIN_EMAIL=carterk279@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-password
