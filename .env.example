# Copy to .env and replace every change-me value before starting the stack.
# .env is git-ignored; never commit real secrets.

# PostgreSQL (also owns the Keycloak database)
POSTGRES_USER=afs
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=afs_command_center

# Keycloak administrator (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password

# AFS realm and the Command Center OIDC client
KEYCLOAK_REALM=afs
OIDC_CLIENT_ID=afs-command-center
OIDC_CLIENT_SECRET=change-me-oidc-client-secret

# Signs the backend session cookie. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-session-secret

# URLs as seen from the browser
PUBLIC_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# ImageUnit (pilot integration). Redirect URI is ImageUnit's API callback; origin is its web app.
IMAGEUNIT_OIDC_CLIENT_ID=imageunit
IMAGEUNIT_OIDC_CLIENT_SECRET=change-me-imageunit-client-secret
IMAGEUNIT_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback
IMAGEUNIT_ORIGIN=http://localhost:4001

# Shared secret that integrated applications send to /api/internal/access. Never expose it to browsers.
AFS_SERVICE_TOKEN=change-me-service-token

# Test account created in the AFS realm on first start
BOOTSTRAP_ADMIN_EMAIL=carterk279@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-password
