{
	email admin@afs-rwanda.org
}

# Command Center portal and API (nginx frontend serves /api/ and /auth/ to the backend).
accesshub.afs-rwanda.org {
	reverse_proxy frontend:80
}

# Central sign-in (Keycloak). The admin console is not published; administer Keycloak through an SSH tunnel to 127.0.0.1:8081.
sso.afs-rwanda.org {
	@admin path /admin /admin/*
	respond @admin 404

	reverse_proxy keycloak:8080
}
